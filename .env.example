# Sightline environment variables — copy to `.env` and fill in real values.
# `.env` is gitignored and must never be committed.

# ---------------------------------------------------------------------------
# Database (Supabase Postgres)
# ---------------------------------------------------------------------------
# Two connection URLs are required, both pointing at the same Supabase project.
#
# DATABASE_URL — transaction-mode POOLER connection (port 6543). Used by the
#   application (Prisma Client at runtime, via a driver adapter). PgBouncer in
#   transaction mode, so append `?pgbouncer=true`.
#
# DIRECT_URL — DIRECT (non-pooled) connection (port 5432). Used by Prisma
#   Migrate and by the Python ingest runtime's bulk writes. Large transactional
#   loads are a poor fit for transaction-mode pooling, so Python connects here.
#
# Find both under: Supabase Dashboard → Project → Connect → ORMs (Prisma),
# or Settings → Database → Connection string (Transaction pooler vs. Direct).

DATABASE_URL="postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:5432/postgres"

# ---------------------------------------------------------------------------
# Tests
# ---------------------------------------------------------------------------
# TEST_DATABASE_URL — the LOCAL Postgres the Python integration tests use
#   (never the remote dev database). Bring one up with `docker compose up -d`
#   and apply migrations with `npx prisma migrate deploy` pointed at it.
#   DB tests skip automatically when this is unset.

# TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5433/sightline"

# ---------------------------------------------------------------------------
# Supabase Auth (Next.js application)
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_* values are inlined into the browser bundle by Next and are safe
# to expose — the anon key carries only the caller's own privileges.
#
# Find these under: Supabase Dashboard → Project → Settings → API.

NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<anon-public-key>"

# SUPABASE_SERVICE_ROLE_KEY — bypasses every Supabase-side check, so its blast
#   radius is the whole auth schema. Server-side only, never sent to a client,
#   never logged. Exactly one module may read it: src/lib/supabase/admin.ts,
#   guarded by an ESLint rule and a structural test.

SUPABASE_SERVICE_ROLE_KEY="<service-role-key>"

# APP_URL — absolute origin of this deployment. Used for absolute links and to
#   identify the environment.

APP_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Deliberately absent
# ---------------------------------------------------------------------------
# No Kalshi variable exists yet. The API key ID and RSA signing key arrive with
# Pitch 11 and carry authority over a funded account; there is nothing to
# misconfigure before then, and nothing should be added here speculatively.

# ---------------------------------------------------------------------------
# Scheduled pipeline (Live Pipeline & Staleness)
# ---------------------------------------------------------------------------
# PIPELINE_SCHEDULER_TOKEN — bearer token the GitHub Actions schedulers present
#   to POST /api/pipeline/price-refresh and /api/pipeline/keepalive. Machine
#   auth only: it can trigger a price refresh and report a keepalive, nothing
#   else. Generate ≥32 chars of randomness (e.g. `openssl rand -hex 32`) and
#   store the same value as a GitHub Actions secret. While unset, the pipeline
#   routes answer 503 so a misconfigured deploy is loud.

# PIPELINE_SCHEDULER_TOKEN="<openssl rand -hex 32>"

# ---------------------------------------------------------------------------
# Seeding the first admin
# ---------------------------------------------------------------------------
# There is no path to the first admin through the product: sign-up creates a
# PENDING account, and only an admin can approve one. `npm run db:seed` creates
# it out of band. Defaults are used when these are unset.

# SEED_ADMIN_EMAIL="troy@sightline.app"
# SEED_ADMIN_PASSWORD="<a real password>"
# SEED_ADMIN_NAME="Troy Rhodes"

# ---------------------------------------------------------------------------
# Deliberately absent
# ---------------------------------------------------------------------------
# No Kalshi variable exists yet. The API key ID and RSA signing key arrive with
# Pitch 11 and carry authority over a funded account; there is nothing to
# misconfigure before then, and nothing should be added here speculatively.

# ---------------------------------------------------------------------------
# Invitation delivery
# ---------------------------------------------------------------------------
# RESEND_API_KEY — required in production. Absent in development, invitations
#   fall back to a console transport that prints the acceptance URL to the
#   SERVER log and never to a response body.
# MAIL_FROM — the From header on invitation emails.
# INVITATION_TTL_HOURS — invitation lifetime; 168 (7 days) per the spec.

# RESEND_API_KEY="re_..."
# MAIL_FROM="Sightline <invites@your-domain>"
# INVITATION_TTL_HOURS="168"
