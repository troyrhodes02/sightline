# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Environment — never commit real secrets. `.env.example` IS committed.
.env
.env.*
!.env.example

# Prisma generated client (regenerated from schema; not source of truth)
/generated/

# Backtest artefacts — millions of per-prediction Parquet rows on local disk,
# never committed. Only BacktestRun aggregates and CalibrationBin rows persist.
/python/artifacts/

# Local Supabase dev config/state (from `supabase start`), not source.
/supabase/

# Python (uv). uv.lock IS committed for reproducibility.
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Next.js build output and dev artefacts
/.next/
/out/
next-env.d.ts
*.tsbuildinfo

# Playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
